DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dedicated long-running workers only. Keep false on serverless deployments.
PAYLOAD_JOBS_AUTORUN=false

# Protects POST /api/payload-jobs/run when invoked by an external cron.
CRON_SECRET=replace-with-at-least-16-random-characters

# Optional real tracking provider. No tracking schedule is registered without this URL.
TRACKING_SYNC_URL=
TRACKING_SYNC_TOKEN=
