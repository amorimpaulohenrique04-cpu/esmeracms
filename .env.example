# Supabase Session Pooler (IPv4 / processos persistentes / migrações).
# Não misture host de Pooler com username "postgres": Pooler exige postgres.PROJECT_REF.
# Percent-encode caracteres reservados da senha, por exemplo # como %23.
# A CA pública versionada em certs/ permite validar certificado e hostname com verify-full.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD_ENCODED@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs%2Fsupabase-prod-ca-2021.crt
PAYLOAD_SECRET=replace-with-at-least-24-random-characters
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional exact browser origins for deco.cx/deco.site. Server-side loaders do not require CORS.
# Never use wildcards. Example: https://your-store.deco.site
DECO_CORS_ORIGINS=

# Dedicated long-running workers only. Keep false on serverless deployments.
PAYLOAD_JOBS_AUTORUN=false

# Protects POST /api/payload-jobs/run when invoked by an external cron.
CRON_SECRET=replace-with-at-least-24-random-characters

# Optional real tracking provider. No tracking schedule is registered without this URL.
TRACKING_SYNC_URL=
TRACKING_SYNC_TOKEN=

# Performance instrumentation. Logs contain static operation names and timings, never filters or PII.
PERFORMANCE_LOGS=false
REPORTING_QUERY_LOGS=false

# PostgreSQL disaster-recovery drill. Must point to an isolated disposable database.
# Opcional no runtime. Obrigatória somente para executar db:restore:test e deve usar outro projeto/banco.
RESTORE_TEST_DATABASE_URL=postgresql://postgres.OTHER_PROJECT_REF:PASSWORD_ENCODED@aws-0-OTHER_REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=certs%2Fsupabase-prod-ca-2021.crt
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore

# Production media contract. The release gate fails until a real S3/R2 adapter is installed and validated.
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_ADAPTER_READY=false
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
