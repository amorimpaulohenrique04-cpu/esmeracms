{
  "name": "esmera-cms",
  "version": "1.0.0",
  "description": "Hub editorial e comercial da Esmera em Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "analyze:bundle": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/analyze-bundle.ts",
    "analyze:dead-code": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/analyze-dead-code.ts",
    "backfill:publication-revisions": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/backfill-publication-revisions.ts",
    "backfill:publication-revisions:dry-run": "pnpm backfill:publication-revisions --dry-run",
    "prebuild": "pnpm generate:types && pnpm generate:importmap",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "ci:production": "pnpm validate:production && pnpm migrate && pnpm ensure:catalog-collections && pnpm build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "ensure:catalog-collections": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/ensure-catalog-collections.ts",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "jobs:run:operational": "pnpm payload jobs:run --cron \"* * * * *\" --queue operational --handle-schedules",
    "jobs:run:integrations": "pnpm payload jobs:run --cron \"*/5 * * * *\" --queue integrations --handle-schedules",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "migrate": "pnpm payload migrate",
    "migrate:status": "pnpm payload migrate:status",
    "migrate:opportunities": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/migrate-opportunities.ts",
    "migrate:opportunities:dry-run": "pnpm migrate:opportunities --dry-run",
    "migrate:opportunities:rollback": "pnpm migrate:opportunities --rollback",
    "migrate:after-sales-followups": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/migrate-after-sales-followups.ts",
    "migrate:after-sales-followups:dry-run": "pnpm migrate:after-sales-followups --dry-run",
    "migrate:after-sales-followups:rollback": "pnpm migrate:after-sales-followups --rollback",
    "db:backup": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/postgres-backup.ts",
    "db:restore:test": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/postgres-restore-test.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:catalog-taxonomy": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/seed-catalog-taxonomy.ts",
    "simplify:navigation-menu": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/simplify-navigation-menu.ts",
    "simplify:navigation-menu:dry-run": "pnpm simplify:navigation-menu --dry-run",
    "simplify:navigation-menu:rollback": "pnpm simplify:navigation-menu --rollback",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm generate:types && pnpm generate:importmap && pnpm typecheck && pnpm lint --max-warnings=0 && pnpm test:int && pnpm build && pnpm analyze:dead-code && pnpm analyze:bundle",
    "validate:release": "pnpm validate && pnpm test:e2e",
    "validate:production": "cross-env NODE_ENV=production NODE_OPTIONS=--no-deprecation tsx src/scripts/production-readiness.ts",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts tests/unit",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "baseline:prepare": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/prepare-visual-baseline.ts",
    "baseline:finalize": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/finalize-visual-baseline.ts",
    "baseline:capture": "pnpm baseline:prepare && cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.baseline.config.ts && pnpm baseline:finalize",
    "baseline:compare": "cross-env NODE_OPTIONS=--no-deprecation tsx src/scripts/compare-visual-baseline.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-s3": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "echarts": "6.1.0",
    "graphql": "^16.8.1",
    "next": "16.2.11",
    "payload": "3.86.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.6",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.11",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  }
}